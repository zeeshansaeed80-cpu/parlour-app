rules_version = '2';

// Stage 1 security rules: only the owner logins listed below can read or write.
// Everyone else (including anyone who finds the app's web address) is blocked by the server.
//
// EDIT THE LIST: the exact email of every owner login you created in
// Firebase -> Authentication -> Users. Lowercase, in quotes, separated by commas.
// Staff access (shop tablet) is added in Stage 3.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [
          'zeeshansaeedffl@gmail.com'
          // , 'wife-email@gmail.com'   <- remove the // and put her email here
        ];
    }

    // Money must be a whole number of rupees, above zero.
    function validTxn() {
      let d = request.resource.data;
      return d.kind in ['sale', 'expense']
        && d.total is int && d.total > 0
        && d.paidNow is int && d.paidNow >= 0 && d.paidNow <= d.total
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (d.kind != 'sale' || (d.clientId is string && d.items is list && d.items.size() > 0));
    }

    match /transactions/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validTxn();
    }

    match /clients/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.phone is string;
    }

    match /categories/{id} { allow read, write: if isOwner(); }
    match /lists/{id}      { allow read, write: if isOwner(); }
    match /meta/{id}       { allow read, write: if isOwner(); }
  }
}
