rules_version = '2';

// Stage 3 security rules.
// - Owners (emails below) can read and change everything.
// - The shop tablet login can only do what staff are allowed to do. This is
//   enforced here on the server, so it can't be bypassed from the tablet.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [
          'zeeshansaeedffl@gmail.com',
          'hinazeeshan822@gmail.com'
        ];
    }

    function isShop() {
      return request.auth != null
        && request.auth.token.email == 'shop@parlour-accounts.firebaseapp.com';
    }

    // Money is always whole rupees. Checks every saved entry.
    function validTxn() {
      let d = request.resource.data;
      return d.kind in ['sale', 'expense', 'clientPayment', 'supplierPayment']
        && d.total is int && d.total > 0
        && d.paidNow is int && d.paidNow >= 0 && d.paidNow <= d.total
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (d.kind != 'sale' || (d.clientId is string && d.items is list && d.items.size() > 0))
        && (d.kind != 'clientPayment' || (d.clientId is string && d.paidNow == d.total))
        && (d.kind != 'supplierPayment' || (d.supplierId is string && d.paidNow == d.total))
        && (d.kind != 'expense' || d.paidNow == d.total || d.supplierId is string);
    }

    // Staff (shop tablet): sales, client payments and paid-in-full expenses only,
    // stamped with the staff member and the server's clock.
    function validStaffTxn() {
      let d = request.resource.data;
      return d.kind in ['sale', 'clientPayment', 'expense']
        && (d.kind != 'expense' || (d.paidNow == d.total && d.supplierId == null))
        && d.createdByStaff is string
        && d.createdByUser == request.auth.uid
        && d.createdAt == request.time;
    }

    function validClient() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.phone is string && d.balance is int;
    }

    match /transactions/{id} {
      allow read: if isOwner();
      allow create: if validTxn() && (isOwner() || (isShop() && validStaffTxn()));
      allow update: if isOwner() && validTxn();
      // Staff can only undo their own entry, shortly after saving it.
      allow delete: if isOwner()
        || (isShop() && resource.data.createdByUser == request.auth.uid
            && request.time < resource.data.createdAt + duration.value(10, 'm'));
    }

    match /clients/{id} {
      allow read: if isOwner() || isShop();
      allow create: if validClient() && (isOwner() || (isShop() && request.resource.data.balance == 0));
      allow update: if validClient() && (isOwner()
        || (isShop() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance'])));
      allow delete: if isOwner();
    }

    match /suppliers/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.balanceOwed is int;
    }

    match /staff/{id} {
      allow read: if isOwner() || isShop();
      allow write: if isOwner();
    }

    match /categories/{id} {
      allow read: if isOwner() || isShop();
      allow write: if isOwner();
    }
    match /lists/{id} {
      allow read: if isOwner() || isShop();
      allow write: if isOwner();
    }
    match /meta/{id} {
      allow read: if isOwner() || (isShop() && id in ['business', 'setup']);
      allow write: if isOwner();
    }
  }
}
