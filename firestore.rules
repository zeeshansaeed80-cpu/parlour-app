rules_version = '2';

// Stage 2 security rules: only the owner logins listed below can read or write.
// Everyone else (including anyone who finds the app's web address) is blocked by the server.
//
// To add an owner: add their exact login email to the list (lowercase, in quotes,
// with a comma between emails). Staff access (shop tablet) is added in Stage 3.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [
          'zeeshansaeedffl@gmail.com',
          'hinazeeshan822@gmail.com'
        ];
    }

    // Money is always whole rupees. Checks every saved entry.
    function validTxn() {
      let d = request.resource.data;
      return d.kind in ['sale', 'expense', 'clientPayment', 'supplierPayment']
        && d.total is int && d.total > 0
        && d.paidNow is int && d.paidNow >= 0 && d.paidNow <= d.total
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (d.kind != 'sale' || (d.clientId is string && d.items is list && d.items.size() > 0))
        && (d.kind != 'clientPayment' || (d.clientId is string && d.paidNow == d.total))
        && (d.kind != 'supplierPayment' || (d.supplierId is string && d.paidNow == d.total))
        && (d.kind != 'expense' || d.paidNow == d.total || d.supplierId is string);
    }

    match /transactions/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validTxn();
    }

    match /clients/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.balance is int;
    }

    match /suppliers/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.balanceOwed is int;
    }

    match /categories/{id} { allow read, write: if isOwner(); }
    match /lists/{id}      { allow read, write: if isOwner(); }
    match /meta/{id}       { allow read, write: if isOwner(); }
  }
}
